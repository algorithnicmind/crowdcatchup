# .env for CrowdShield Backend

# --- Database ---
# Strict Constraint: We are explicitly using Neon DB as our cloud database. 
# Do not use local PostgreSQL.
DATABASE_URL=postgresql+asyncpg://<neon_user>:<neon_password>@<neon_host>/<neon_db>?sslmode=require

# --- Redis ---
# Local Redis (Required as per AGENTS.md):
REDIS_URL=redis://localhost:6379

# --- JWT ---
JWT_SECRET=crowdshield-dev-secret-change-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRY_MINUTES=60

# --- Application ---
DEBUG=true
