# .env template for CrowdShield Backend
# Copy this file to .env and fill in your values.
# NEVER commit the actual .env file to git.

# --- Database ---
# Neon DB (Cloud PostgreSQL):
# DATABASE_URL=postgresql+asyncpg://<neon_user>:<neon_password>@<neon_host>/<neon_db>?sslmode=require

# --- Redis ---
# Leave empty for in-memory fallback (local dev):
REDIS_URL=
# Production Local Redis:
# REDIS_URL=redis://localhost:6379

# --- JWT ---
JWT_SECRET=crowdshield-dev-secret-change-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRY_MINUTES=60


# --- Application ---
DEBUG=true
