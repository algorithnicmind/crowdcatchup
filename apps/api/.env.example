# .env template for CrowdShield Backend
# Copy this file to .env and fill in your values.
# NEVER commit the actual .env file to git.

# --- Database ---
# Local SQLite (default for development):
DATABASE_URL=sqlite+aiosqlite:///./crowdshield.db
# Production PostgreSQL/Supabase:
# DATABASE_URL=postgresql+asyncpg://user:password@host:5432/crowdshield

# --- Redis ---
# Leave empty for in-memory fallback (local dev):
REDIS_URL=
# Production Upstash Redis:
# REDIS_URL=redis://default:password@host:port

# --- JWT ---
JWT_SECRET=crowdshield-dev-secret-change-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRY_MINUTES=60

# --- Supabase (optional) ---
SUPABASE_URL=
SUPABASE_KEY=

# --- Application ---
DEBUG=true
